<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so the link inspector can follow http:// links.
     That traffic only ever goes through Tor or a proxy, never directly. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
